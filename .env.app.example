# Application runtime only; not the root SSH operations .env.local.
# Export variables in your shell or existing service environment.
VC_ADMIN_USER=admin
VC_ADMIN_PASS=
# VC_DATA_DIR=/var/lib/ai-berkshire-web
# VC_PLATFORM_CONFIG=/etc/ai-berkshire-web/platform.json
# VC_FRAMEWORK_DIR=/opt/ai-berkshire-web/framework
# No reports or framework are downloaded automatically by default.
VC_AUTO_DOWNLOAD_FRAMEWORK=false
# Optional external upstream for explicit synchronization/download:
# VC_FRAMEWORK_REPO=https://github.com/xbtlin/ai-berkshire.git
