# Local SSH operations only. This file is NOT loaded by the web application.
# Copy to .env.local only if it does not already exist. Never commit real values.
# Shell variables override the file. Paths below refer to the REMOTE server.
# SSH key paths and known_hosts paths refer to THIS computer/config directory.
VC_SSH_HOST=replace_with_server_host
VC_SSH_PORT=22
VC_SSH_USER=root
# Choose password or private key authentication; leave the unused field empty.
VC_SSH_PASSWORD=
VC_SSH_KEY_FILE=
# Optional SHA256:... pin; otherwise remember the first host key locally.
VC_SSH_HOST_KEY_SHA256=
VC_SSH_KNOWN_HOSTS=.local/known_hosts
VC_REMOTE_DIR=/opt/ai-berkshire-web
VC_DATA_DIR=/var/lib/ai-berkshire-web
VC_BACKUP_DIR=/var/backups/ai-berkshire-web
VC_SERVICE=ai-berkshire-web.service
# Existing systemd EnvironmentFile: checked for existence, never overwritten.
VC_REMOTE_ENV=/etc/ai-berkshire-web.env
# Server-side readiness endpoint.
VC_HEALTH_URL=http://127.0.0.1:8765/api/auth/policy
# Reachable FROM THIS computer, including /api/auth/policy. Empty skips public check.
VC_PUBLIC_URL=
